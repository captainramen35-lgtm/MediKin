rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /profiles/{profileId} {
      // Public read — needed for emergency brief page (no login required)
      allow read: if true;
      // Create requires auth
      allow create: if request.auth != null;
      // Update/delete requires being the owner or a family member
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.familyMembers
      );

      // Subcollections for checkups and vitals
      match /checkups/{checkupId} {
        allow read, write: if request.auth != null;
      }
      match /vitalsHistory/{historyId} {
        allow read, write: if request.auth != null;
      }
    }

    match /sosLogs/{logId} {
      allow read, create: if request.auth != null;
    }
  }
}
